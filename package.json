{
  "name": "workflow-journal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "data:dev": "npm --prefix ../data-app run dev",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "stylelint": "stylelint \"src/**/*.scss\"",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:pwa": "NEXT_PUBLIC_ACTIVITY_API_URL='' npm run build && NEXT_PUBLIC_ACTIVITY_API_URL='' PWA_E2E=1 playwright test --project=pwa"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass": "^1.104.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
